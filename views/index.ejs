<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Weather App</title>
  <link rel="stylesheet" href="style.css" />
</head>
<style>
    * {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", sans-serif;
}

body {
  min-height: 100vh;
  background: linear-gradient(135deg, #4facfe, #00f2fe);
  display: flex;
  justify-content: center;
  align-items: center;
}

.app {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 30px;
  border-radius: 15px;
  width: 320px;
  text-align: center;
  color: #fff;
}

h1 {
  margin-bottom: 20px;
}

.search-box {
  display: flex;
  gap: 10px;
}

.search-box input {
  flex: 1;
  padding: 10px;
  border-radius: 8px;
  border: none;
  outline: none;
}

.search-box button {
  padding: 10px 15px;
  border: none;
  border-radius: 8px;
  background: #fff;
  color: #333;
  cursor: pointer;
  font-weight: bold;
}

.search-box button:hover {
  background: #f1f1f1;
}

.weather-card {
  margin-top: 20px;
}

.weather-card img {
  width: 80px;
}

.temp {
  font-size: 40px;
  font-weight: bold;
}

.details {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
}

.loading {
  margin-top: 20px;
}

.error {
  margin-top: 15px;
  color: #ffdddd;
}

.hidden {
  display: none;
}

</style>
<body>

  <div class="app">
    <h1>🌤 Weather App</h1>

    <div class="search-box">
      <input type="text" id="cityInput" placeholder="Enter city or country" />
      <button id="searchBtn">Search</button>
    </div>

    <div id="loading" class="loading hidden">Loading...</div>

    <div id="weatherCard" class="weather-card hidden">
      <h2 id="location"></h2>
      <img id="icon" />
      <p class="temp"><span id="temp"></span>°C</p>
      <p id="condition"></p>

      <div class="details">
        <div>💨 Wind: <span id="wind"></span> km/h</div>
        <div>💧 Humidity: <span id="humidity"></span>%</div>
      </div>
    </div>

    <p id="error" class="error hidden"></p>
  </div>

  <script>
const searchBtn = document.getElementById("searchBtn");
const cityInput = document.getElementById("cityInput");
const search = document.querySelector('input[type=sea]')
const weatherCard = document.getElementById("weatherCard");
const loading = document.getElementById("loading");
const error = document.getElementById("error");

searchBtn.addEventListener("click", getWeather);

async function getWeather() {
  const city = cityInput.value.trim();
  if (!city) return;

  weatherCard.classList.add("hidden");
  error.classList.add("hidden");
  loading.classList.remove("hidden");

  try {
    const response = await fetch(`/weather?city=${city}`);
    const data = await response.json();

    if (data.error) {
      throw new Error(data.error.message);
    }

    displayWeather(data);
  } catch (err) {
    error.textContent = err.message || "Failed to fetch weather";
    error.classList.remove("hidden");
  } finally {
    loading.classList.add("hidden");
  }
}

function displayWeather(data) {
  document.getElementById("location").textContent =
    `${data.location.name}, ${data.location.country}`;

  document.getElementById("temp").textContent = data.current.temp_c;
  document.getElementById("condition").textContent = data.current.condition.text;
  document.getElementById("wind").textContent = data.current.wind_kph;
  document.getElementById("humidity").textContent = data.current.humidity;
  document.getElementById("icon").src = data.current.condition.icon;

  weatherCard.classList.remove("hidden");
}

  </script>
</body>
</html>
